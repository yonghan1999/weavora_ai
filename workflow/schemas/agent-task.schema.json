{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhijie:agent-task",
  "title": "Agent 任务输入契约",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "task_id", "stage", "objective", "baselines", "context_files", "constraints", "acceptance_criteria", "tools_and_permissions"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["A_INTAKE", "B_REQUIREMENTS", "B1_PROTOTYPE", "B2_UI", "C_DESIGN", "D_PLANNING", "E_IMPLEMENTATION", "F_SELF_TEST", "G_INDEPENDENT_TEST", "H_RELEASE", "I_ACCEPTANCE"]},
    "objective": {"type": "string", "minLength": 1},
    "baselines": {"type": "object", "properties": {"requirements": {"type": ["string", "null"]}, "prototype": {"type": ["string", "null"]}, "ui": {"type": ["string", "null"]}, "design": {"type": ["string", "null"]}, "digest": {"type": ["string", "null"]}}},
    "context_files": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tools_and_permissions": {"type": "array", "items": {"type": "string"}}
  }
}
