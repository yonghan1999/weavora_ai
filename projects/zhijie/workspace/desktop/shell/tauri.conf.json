{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "织界",
  "identifier": "app.weavora.zhijie",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "织界",
        "width": 1280,
        "height": 800,
        "minWidth": 600,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b0d0f",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Weavora",
    "createUpdaterArtifacts": false
  }
}
