# 默认不启用邮件。填写后仅将变量注入控制面服务进程；不要提交真实凭据。
# 此文件不会由 Spring 自动加载。关闭时健康检查不探测 SMTP，注册和找回返回 503。
# 本机受控 HTTP/SMTP 回归（从 workspace 执行，无需邮箱账号）：
# ./mvnw.cmd -o -pl control-plane "-Dtest=SmtpEmailDispatchAdapterTest" test
# 该回归不验证外部服务的 TLS、认证或实际收件；不要将其回环测试配置用于外部邮箱。
ZHIJIE_MAIL_ENABLED=false
ZHIJIE_MAIL_FROM=
ZHIJIE_SMTP_HOST=
ZHIJIE_SMTP_PORT=587
ZHIJIE_SMTP_USERNAME=
ZHIJIE_SMTP_PASSWORD=
ZHIJIE_SMTP_AUTH=true
ZHIJIE_SMTP_STARTTLS=true
ZHIJIE_SMTP_SSL=false
