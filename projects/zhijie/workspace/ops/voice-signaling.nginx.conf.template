# 放入 nginx http 上下文；生成配置时替换域名、证书路径和管理密钥占位符。
# 不在此文件存放真实密钥。禁用查询参数日志，避免记录 SDK query token / join_request。
map $http_upgrade $zhijie_voice_connection {
    default upgrade;
    '' close;
}

server {
    ${VOICE_LISTENER}
    access_log off;

    location = /_voice_authorize {
        internal;
        proxy_pass http://127.0.0.1:${CONTROL_PORT}/internal/voice/v1/authorize;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Voice-Token $zhijie_voice_query_token;
        proxy_set_header X-Voice-Key "${ZHIJIE_VOICE_SIGNALING_KEY}";
        proxy_connect_timeout 1s;
        proxy_read_timeout 2s;
    }

    location ~ ^/rtc(?:/v1)?(?:/validate)?$ {
        set $zhijie_voice_query_token $arg_access_token;
        auth_request /_voice_authorize;
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $zhijie_voice_connection;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 75s;
    }

    # 不向客户端暴露 SFU RoomService 或控制面管理接口。
    location / { return 404; }
}
