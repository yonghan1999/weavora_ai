 const QUERY_FAILED: &str = "NETWORK_CONFIGURATION_UNAVAILABLE";
+
+/// Configure only the IPv4 tunnel; 1040 is below IPv6's minimum link MTU.
+pub(super) fn set_ipv4_mtu(luid: u64, mtu: u16) -> std::io::Result<()> {
+    use windows_sys::Win32::NetworkManagement::{
+        IpHelper::{GetIpInterfaceEntry, SetIpInterfaceEntry, MIB_IPINTERFACE_ROW},
+        Ndis::NET_LUID_LH,
+    };
+    let mut row = MIB_IPINTERFACE_ROW {
+        Family: AF_INET,
+        InterfaceLuid: NET_LUID_LH { Value: luid },
+        ..Default::default()
+    };
+    let code = unsafe { GetIpInterfaceEntry(&mut row) };
+    if code != 0 {
+        return Err(std::io::Error::from_raw_os_error(code as i32));
+    }
+    row.SitePrefixLength = 0;
+    row.NlMtu = u32::from(mtu);
+    let code = unsafe { SetIpInterfaceEntry(&mut row) };
+    if code != 0 {
+        return Err(std::io::Error::from_raw_os_error(code as i32));
+    }
+    Ok(())
+}

